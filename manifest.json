{
  "manifest_version": 3,
  "name": "Ad Cleaner for Marktplaats",
  "version": "1.1.0",
  "description": "Adds independent controls for promoted and website-directed Marktplaats listings.",
  "homepage_url": "https://github.com/otaliptus/marktplaats-ad-cleaner",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.marktplaats.nl/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
